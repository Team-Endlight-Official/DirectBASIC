{
    "version": "2.0.0",
    "tasks": [
        // TASKS FOR WINDOWS 32 BIT!
        { // Main 
            "label": "Compile main win-x86",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "fpc src/main.pas -o\"./bin/win-x86/directbasic.exe\" -Fusrc/vm -Fuexternal -Fusrc/rtl "
            ],
            "problemMatcher": []
        },
        { // Test program
            "label": "Compile test win-x86",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "fpc src/test.pas -o\"./bin/win-x86/dbtest.exe\" -Fusrc/vm -Fuexternal -Fusrc/rtl "
            ],
            "problemMatcher": []
        },
        { // Editor program
            "label": "Compile edit win-x86",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "fpc src/edit.pas -o\"./bin/win-x86/dbedit.exe\" -Fusrc/vm -Fuexternal -Fuexternal/sdl2 -Fiexternal/sdl2 -Fusrc/rtl -Fusrc/edit "
            ],
            "problemMatcher": []
        },
        { // ORGANIZE UNITS AND MOVE .PPU AND .O FILES INTO OBJ FOLDER (32-BIT)
            "label": "fpcorg_x86",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "move /Y bin\\win-x86\\*.ppu bin\\obj\\ && move /Y bin\\win-x86\\*.o bin\\obj\\"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build main win-x86",
            "dependsOn": [
                "Compile main win-x86",
                "fpcorg_x86"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build test win-x86",
            "dependsOn": [
                "Compile test win-x86",
                "fpcorg_x86"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build edit win-x86",
            "dependsOn": [
                "Compile edit win-x86",
                "fpcorg_x86"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }

        // TASKS FOR WINDOWS 64 BIT!
    ]
}